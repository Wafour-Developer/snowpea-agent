{
  "steps": [
    {
      "match": "run something risky",
      "text": "running",
      "tool_calls": [
        {
          "name": "shell",
          "arguments": {
            "command": "rm -rf build"
          }
        }
      ]
    },
    {
      "match": "hello",
      "text": "Hi from fake"
    },
    {
      "match": "run ls",
      "tool_calls": [
        {
          "name": "shell",
          "arguments": {
            "command": "ls"
          }
        }
      ],
      "text": "running"
    },
    {
      "after_tool": "shell",
      "text": "done"
    },
    {
      "match": "stall forever",
      "delaySec": 5,
      "text": "too late"
    }
  ],
  "default": {
    "text": "dflt"
  }
}
