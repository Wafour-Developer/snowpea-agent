{
  "steps": [
    {
      "match": "계획을 마무리",
      "text": "계획 끝",
      "repeat": true,
      "tool_calls": [{"name": "set_mode", "arguments": {"mode": "accept"}}]
    },
    {
      "after_tool": "set_mode",
      "text": "구현 시작",
      "repeat": true,
      "tool_calls": [{"name": "write_file", "arguments": {"path": "out.py", "content": "x = 1\n"}}]
    },
    {"after_tool": "write_file", "text": "완료", "repeat": true}
  ],
  "default": {"text": "fake default reply"}
}
