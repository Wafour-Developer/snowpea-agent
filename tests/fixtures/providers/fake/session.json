{
  "steps": [
    {
      "match": "write a greeting",
      "text": "writing the file",
      "tool_calls": [
        {"name": "write_file", "arguments": {"path": "greeting.txt", "content": "hello\n"}}
      ]
    },
    {"after_tool": "write_file", "text": "wrote greeting.txt"},
    {
      "match": "edit the greeting",
      "text": "editing",
      "tool_calls": [
        {"name": "edit_file", "arguments": {"path": "greeting.txt", "old": "hello", "new": "bonjour"}}
      ]
    },
    {"after_tool": "edit_file", "text": "edited greeting.txt"},
    {
      "match": "please run ls",
      "text": "running",
      "repeat": true,
      "tool_calls": [{"name": "shell", "arguments": {"command": "echo listed"}}]
    },
    {"after_tool": "shell", "text": "done", "repeat": true}
  ],
  "default": {"text": "nothing to do"}
}
