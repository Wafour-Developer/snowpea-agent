{
  "description": "Fixture hooks: record every tool call in a marker file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${SNOWPEA_PYTHON} \"${CLAUDE_PLUGIN_ROOT}/hooks/record_tool.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
